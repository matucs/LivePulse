NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://livepulse:livepulse_local_dev@localhost:5433/livepulse
REDIS_URL=redis://localhost:6380

SPORTS_PROVIDER=api-football
# Get a free key at https://www.api-football.com/ — never commit a real one.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# docs/adr/ADR-007 addendum: a second, narrower provider used only for
# standings — API-Football's free tier can't supply current-season
# standings at all (docs/adr/ADR-002 addendum). Optional: without this,
# standings are honestly not polled, never faked. Get a free token at
# https://www.football-data.org/client/register — never commit a real one.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# docs/adr/ADR-003 — real Kafka locally (docker compose up kafka kafka-ui),
# Redis Streams for the free Portfolio Mode deployment (docs/adr/ADR-008).
# Leave unset to disable event publishing entirely (§22 graceful degradation
# — ingestion still writes PostgreSQL/Redis directly either way).
EVENT_BUS_DRIVER=kafka
KAFKA_BROKERS=localhost:9092

# ADR-002 polling tiers (milliseconds)
LIVE_POLL_INTERVAL_MS=240000
PREMATCH_POLL_INTERVAL_MS=300000
UPCOMING_POLL_INTERVAL_MS=1800000

# ADR-002 daily request budget allocation (must sum to <= 100 on the free tier)
DAILY_REQUEST_BUDGET=100
DAILY_BUDGET_LIVE=70
DAILY_BUDGET_FIXTURES=15
DAILY_BUDGET_STANDINGS=10
DAILY_SAFETY_MARGIN=5

# API-Football league external IDs to track (§19: kept small deliberately)
TRACKED_LEAGUE_IDS=39,140,135,78,61,2

FRONTEND_ORIGIN=http://localhost:3000

# §21 tracing (docs/observability.md) — optional. Unset by default: tracing
# instrumentation loads but exports nowhere. Point it at a local Jaeger
# (docker run -p 4318:4318 -p 16686:16686 jaegertracing/all-in-one) or a
# hosted OTLP collector to see real traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
