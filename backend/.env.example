NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://livepulse:livepulse_local_dev@localhost:5433/livepulse
REDIS_URL=redis://localhost:6380

SPORTS_PROVIDER=api-football
# Get a free key at https://www.api-football.com/ — never commit a real one.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ADR-002 polling tiers (milliseconds)
LIVE_POLL_INTERVAL_MS=240000
PREMATCH_POLL_INTERVAL_MS=300000
UPCOMING_POLL_INTERVAL_MS=1800000

# ADR-002 daily request budget allocation (must sum to <= 100 on the free tier)
DAILY_REQUEST_BUDGET=100
DAILY_BUDGET_LIVE=70
DAILY_BUDGET_FIXTURES=15
DAILY_BUDGET_STANDINGS=10
DAILY_SAFETY_MARGIN=5

# API-Football league external IDs to track (§19: kept small deliberately)
TRACKED_LEAGUE_IDS=39,140,135,78,61,2

FRONTEND_ORIGIN=http://localhost:3000
